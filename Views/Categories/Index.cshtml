@model List<WebApplicationShop.Models.Category>

<h1>Категории товаров</h1>

@if (User.IsInRole("Admin"))
{
    <a asp-action="Create" class="btn btn-primary">Добавить категорию</a>
}

<table class="table">
    <thead>
        <tr>
            @if (User.IsInRole("Admin"))
            {
                <th>№</th>
            }
            <th>Название</th>
            @if (User.IsInRole("Admin"))
            {
                <th>Действия</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                    @if (User.IsInRole("Admin"))
                {
                    <td>@item.Id</td>
                }
                <td>@item.Name</td>
                @if (User.IsInRole("Admin"))
                {
                    <td>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Удалить</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary">Изменить</a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>